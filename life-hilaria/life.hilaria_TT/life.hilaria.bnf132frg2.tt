<meta Coptic_edition="&lt;a href='https://archive.org/details/lgendescoptesfr00revigoog/page/n60/mode/2up'&gt;Giron 1907 49-58&lt;/a&gt;, Drescher 1947" Greek_source="none" OrigDate_notBefore="901" Trismegistos="none" annotation="Lydia Bremer-McCollum, Nicholas Wagner, Caroline T. Schroeder" attributed_author="Pambo of Scetis" author="unknown" collection="Manuscrits coptes" corpus="life.hilaria" country="Egypt" document_cts_urn="urn:cts:copticLit:lives.hilaria.clm1791:47-50" entities="automatic" facsimile="&lt;a href='https://gallica.bnf.fr/ark:/12148/btv1b52506755c'&gt;https://gallica.bnf.fr/ark:/12148/btv1b52506755c&lt;/a&gt;" idno="132.1 f. 21" language="Sahidic Coptic" license="&lt;a href='https://creativecommons.org/licenses/by/4.0/'&gt;CC-BY 4.0&lt;/a&gt;" msItem_title ="Life of Hilaria" msName="none" next="urn:cts:copticLit:lives.hilaria.clm1792:50-59" note="Coptic SCRIPTORIUM's edition includes only Giron's transcription of the manuscript. It is not a diplomatic transcription based on reading and collation of the original manuscript. Dating taken from PATHS entry for MONB.DL; ms entry notes that hand is the same as MONB.DL. Page numbers missing/lost from the original manuscript. Giron published this work under the title &quot;History of the Daughters of Zeno.&quot; Chapter divisions follow paragraph divisions in Drescher 1947 pp 69-82 English translation. Important facsimile note: the BN posted images out of order; on Gallica they are in the order 19v, 19r, 20v, 20r, 21v, 21r" objectType="codex" order="4" origDate="between 901 and 1050" origDate_notAfter="1050" origDate_precision="low" origPlace="White Monastery" pages_from="uncertain" pages_to="uncertain" parsing="automatic" paths_authors="&lt;a href='http://paths.uniroma1.it/atlas/authors/80'&gt;80&lt;/a&gt;" paths_manuscripts="&lt;a href='http://paths.uniroma1.it/atlas/manuscripts/1791'&gt;1791&lt;/a&gt;" paths_works="&lt;a href='http://paths.uniroma1.it/atlas/works/247'&gt;cc0247&lt;/a" placeName="Atripe