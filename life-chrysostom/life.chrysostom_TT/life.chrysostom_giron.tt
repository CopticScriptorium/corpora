<meta Coptic_edition="&lt;a href='https://archive.org/details/lgendescoptesfr00revigoog/page/n40/mode/2up'&gt;Giron 1907 25-30&lt;/a&gt;" OrigDate_notBefore="1100" Trismegistos="none" annotation="Lydia Bremer-McCollum, Nicholas Wagner, Caroline T. Schroeder" attributed_author="Cyril of Alexandria" author="unknown" collection="Manuscrits coptes" copyist="none" corpus="life.chrysostom" country="Egypt" document_cts_urn="urn:cts:copticLit:lives.chrysostom.giron_ed:400-405" facsimile="&lt;a href='https://gallica.bnf.fr/ark:/12148/btv1b100896227/f5.item.r=Copte129'&gt;https://gallica.bnf.fr/ark:/12148/btv1b100896227/f5.item.r=Copte129&lt;/a&gt;" idno="Copte 129.17 ff. 2-3" language="Sahidic Coptic" license="&lt;a href='https://creativecommons.org/licenses/by/4.0/'&gt;CC-BY 4.0&lt;/a&gt;" msItem_title ="Life of John Chrysostom" msName="MONB.FB" note="Coptic SCRIPTORIUM's edition includes only Giron's transcription of the manuscript. It is not a diplomatic transcription based on reading and collation of the original manuscript. Giron titled this document &quot;Sacrifice of Abraham,&quot; but it is now known to be one of the fragments of the Coptic Life/Lives  of John Chrysostom. Chapter divisions follow paragraph divisions in Giron's French translation. Giron reversed the recto and verso of folio 2 in his transcription. Orlandi 1977 labels this document as Fragment 4. Hence our page and chapter ids reflect this classification." objectType="codex" order="1" origDate="between 901 and 1100" origDate_notAfter="901" origDate_precision="medium" origPlace="White Monastery" pages_from="uncertain" pages_to="uncertain" parsing="automatic" paths_authors="&lt;a href='http://paths.uniroma1.it/atlas/authors/33'&gt;33&lt;/a&gt;" paths_manuscripts="&lt;a href='http://paths.uniroma1.it/atlas/manuscripts/377'&gt;377&lt;/a&gt;" paths_works="&lt;a href='http://paths.uniroma1.it/atlas/works/629'&gt;629&lt;/a&gt;" placeName="Atripe" project="Coptic SCRIPTORIUM" redundant="no" repository="Bibliothèque nationale de France" segmentation="automatic" source="&lt;a href='https://archive.org/details/lgendescoptesfr00revigoog/page/n82/mode/2up'&gt;Giron on archive.org&lt;/a&gt;" source_info="OCR of Giron pdf on archive.org using OCR4all" tagging="automatic" title="Life of John Chrysostom (Giron Sacr of Abraham)" translation="none" version_date="2026-06-08" version_n="6.3.0" witness="none">
