<chapter_n chapter_n="40">
<verse_n verse_n="1">
<translation translation="And another shooteth an arrow into our hands, which leadeth us on to deeds of rapine, and greed of the most excessive character.">
<ed_line_n ed_line_n="21">
<orig_group orig_group="Ⲕⲉⲟⲩⲁ̅">
