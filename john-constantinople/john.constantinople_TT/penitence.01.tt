<chapter_n chapter_n="85">
<verse_n verse_n="1">
<translation translation="and if thou canst not wash away thy sins by means of thy tears like the harlot, flee thou to the foot of the Merciful, and thou thyself shalt say, with David, 'Have mercy upon me, O God, according to the greatness of Thy mercy.'">
