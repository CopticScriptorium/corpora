<chapter_n chapter_n="109">
<verse_n verse_n="1">
<translation translation="Moreover, on many occasions thou hast said, 'They have treated me unjustly, they have defrauded me of my property, they have done me an injury, and they have spoken evil things against me ';">
<ed_line_n ed_line_n="31">
<orig_group orig_group="Ⲁⲗⲗⲁ">
