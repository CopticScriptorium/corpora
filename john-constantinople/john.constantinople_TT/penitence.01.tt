<chapter_n chapter_n="96">
<verse_n verse_n="1">
<translation translation="In that Other World one man shall not be able to give help to another, and no man shall be able to deliver himself from the decision of the Judge, wherefrom no escape may be obtained by supplication.">
<ed_line_n ed_line_n="22">
